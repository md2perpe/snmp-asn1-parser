{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mib",
      "camelcase": "MIB",
      "title": "Management Information Base",
      "scope": "source.mib",
      "file-types": [
        "mib"
      ],
      "injection-regex": "^mib$",
      "class-name": "TreeSitterMib"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Management Information Base",
    "authors": [
      {
        "name": "Per Persson",
        "email": "md2perpe@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-mib",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}