            dcpInterfaceFlexgridWavelength, dcpInterfaceFlexgridDescription, dcpInterfaceFlexgridPortType, dcpInterfaceFlexgridPortMode, dcpInterfaceOsnr, dcpInterfaceRemoteOsnr
    }
